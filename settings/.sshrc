# _____________________________________________________________________________________________
# Command line prompt
red=$(tput setaf 1);
yellow=$(tput setaf 3);
blue=$(tput setaf 4);
green=$(tput setaf 2);
orange=$(tput setaf 166);
white=$(tput setaf 15);
violet=$(tput setaf 92);
bold=$(tput bold);
reset=$(tput sgr0);

parse_git_branch() {
     git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/*//'
}
if [ "$SSH_CONNECTION" ]; then 
    PS1="\[${bold}${violet}\]\h:";
else
    PS1=""
fi
PS1+="\[${bold}${orange}\]\w";
PS1+="\$(parse_git_branch \"\[${white}\]\[${orange}\]\"\"\[${blue}\]\") ";  # git branch name
PS1+="\[${reset}${bold}\]";
PS1+="\[${reset}${bold}\]\$ \[${reset}\]";clear;
export PS1;

# _____________________________________________________________________________________________
# Grep Colouring
export GREP_OPTIONS='--color=always'

# _____________________________________________________________________________________________
# Aliases

# Python
alias pipenvs='echo ~/.local/share/virtualenvs/ ; ls ~/.local/share/virtualenvs/'
alias pyenvs='pyenv versions'
alias pip='pip3'
alias activate='source .venv/bin/activate'
ufreeze() { # uv pip freeze | grep <lib> >> requirements.txt
    local pattern=$(printf "%s|" "$@")
    pattern="${pattern%|}"
    uv pip freeze | grep --color=never -iE "(${pattern})==" >> requirements.txt
    cat requirements.txt
}

# RecallPro
alias r='recallpro'

# AI
alias c='claude'
alias o='opencode'

# ssh
alias ssh='sshrc'

# ranger
alias q='source ranger'

# terminal
function cd {
    builtin cd "$@" && ls -1
}
alias ls='ls -1'
alias t='tree'
alias watch='watch '	# Make watch work with aliases

# brew
alias bs='brew services'

# forklift
alias ft='open . -a forklift'

# kakfa
alias kt='kafka-topics --bootstrap-server localhost:9092'
alias kc='kafka-consumer-groups --bootstrap-server localhost:9092'
alias kcat='kcat -b localhost:9092'

# git
alias gf='git fetch'
alias gd='git diff'
alias gp='git pull'
alias gs='git status'
alias gb='git branch'
alias gl='git log --oneline -20'
alias gll='git log --oneline --graph --all -25'
alias ga='git add -A'
alias gr='git reset'
alias gc='git checkout'
alias gt='git stash'
alias gm='git commit'
alias gu='git push -u origin `parse_git_branch`'
alias gma='git add -A; git commit --amend --no-edit'

function gmm {
    if [ -z "$1" ]; then
        echo "No parameter was provided."
        ga && gm -m wip && gu
        echo "No parameter was provided."
    else
        echo "The provided parameter is: $1"
        ga && gm -m "$1" && gu
        echo "The provided parameter is: $1"
    fi
}

# docker
alias d='docker'

alias dr='docker run'

alias dv='docker volume'

alias dc='docker container'
alias dcc='docker container rm -f $(docker container ls -aq)'

alias di='docker image'
alias dii='docker image rm -f $(docker image ls -q) || true'

# terraform
alias tfenv='GREP_OPTIONS="--color=never" tfenv'
alias tf='terraform'

# kubernetes
alias k='kubectl'
# alias kc='k config get-contexts'
alias kcu='k config use-context'
function kcn() {
	k config set-context --current --namespace=$1
}
alias kv='kubeval'

# helm
alias h='helm'

# maven
alias ma='mvn archetype:generate'
alias mc='mvn clean'
alias mcc='mvn resources:resources compiler:compile'
alias mct='mvn resources:testResources compiler:testCompile'
alias mt='mvn surefire:test'
alias me='mvn compiler:compile exec:java'
alias mr='mvn resources:resources compiler:compile exec:java'
alias mj='mvn jar:jar shade:shade'

# gradle
alias g='gradle --console=verbose'
alias gw='./gradlew --console=verbose'

# yt-dlp
alias yt='yt-dlp -f 'ba' -x --audio-format mp3 '










