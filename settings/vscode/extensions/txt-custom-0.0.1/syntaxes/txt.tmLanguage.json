{
    "name": "TxtCustom",
    "scopeName": "source.txtcustom",
    "patterns": [
        {
            "include": "#fenced"
        },
        {
            "include": "#key"
        },
        {
            "include": "#flag"
        },
        {
            "include": "#comment"
        },
        {
            "include": "#backtick"
        },
        {
            "include": "#dquote"
        },
        {
            "include": "#brackets"
        }
    ],
    "repository": {
        "comment": {
            "match": "#.*$",
            "name": "comment.line.number-sign.txtcustom"
        },
        "backtick": {
            "match": "`[^`]*`",
            "name": "comment.backtick.txtcustom"
        },
        "dquote": {
            "match": "\"[^\"]*\"",
            "name": "string.quoted.double.txtcustom"
        },
        "key": {
            "match": "([A-Za-z_][A-Za-z0-9_.\\-]*)\\s*(?==(?!=))",
            "captures": {
                "1": {
                    "name": "variable.other.key.txtcustom"
                }
            }
        },
        "flag": {
            "match": "(?<!\\S)--?[A-Za-z][A-Za-z0-9-]*",
            "name": "variable.parameter.flag.txtcustom"
        },
        "brackets": {
            "match": "[(){}\\[\\]]",
            "name": "punctuation.bracket.txtcustom"
        },
        "fenced": {
            "patterns": [
                {
                    "include": "#fenced-python"
                },
                {
                    "include": "#fenced-shell"
                },
                {
                    "include": "#fenced-sql"
                },
                {
                    "include": "#fenced-js"
                },
                {
                    "include": "#fenced-jsx"
                },
                {
                    "include": "#fenced-ts"
                },
                {
                    "include": "#fenced-tsx"
                },
                {
                    "include": "#fenced-json"
                },
                {
                    "include": "#fenced-jsonc"
                },
                {
                    "include": "#fenced-yaml"
                },
                {
                    "include": "#fenced-toml"
                },
                {
                    "include": "#fenced-html"
                },
                {
                    "include": "#fenced-xml"
                },
                {
                    "include": "#fenced-css"
                },
                {
                    "include": "#fenced-scss"
                },
                {
                    "include": "#fenced-less"
                },
                {
                    "include": "#fenced-markdown"
                },
                {
                    "include": "#fenced-java"
                },
                {
                    "include": "#fenced-c"
                },
                {
                    "include": "#fenced-cpp"
                },
                {
                    "include": "#fenced-csharp"
                },
                {
                    "include": "#fenced-fsharp"
                },
                {
                    "include": "#fenced-objc"
                },
                {
                    "include": "#fenced-go"
                },
                {
                    "include": "#fenced-rust"
                },
                {
                    "include": "#fenced-ruby"
                },
                {
                    "include": "#fenced-php"
                },
                {
                    "include": "#fenced-perl"
                },
                {
                    "include": "#fenced-lua"
                },
                {
                    "include": "#fenced-r"
                },
                {
                    "include": "#fenced-swift"
                },
                {
                    "include": "#fenced-kotlin"
                },
                {
                    "include": "#fenced-scala"
                },
                {
                    "include": "#fenced-groovy"
                },
                {
                    "include": "#fenced-dart"
                },
                {
                    "include": "#fenced-clojure"
                },
                {
                    "include": "#fenced-coffee"
                },
                {
                    "include": "#fenced-powershell"
                },
                {
                    "include": "#fenced-dockerfile"
                },
                {
                    "include": "#fenced-makefile"
                },
                {
