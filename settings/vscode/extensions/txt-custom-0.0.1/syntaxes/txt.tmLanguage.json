                {
                    "include": "#fenced-plain"
                }
            ]
        },
        "fenced-plain": {
            "begin": "^(\\s*)(`{3,}).*$",
            "beginCaptures": {
                "2": {
                    "name": "punctuation.definition.fenced.txtcustom"
                }
            },
            "end": "^(\\s*)(`{3,})[ \\t]*$",
            "endCaptures": {
                "2": {
                    "name": "punctuation.definition.fenced.txtcustom"
                }
            },
            "name": "markup.fenced_code.block.txtcustom",
            "contentName": "markup.raw.block.txtcustom"
        },
        "fenced-python": {
            "begin": "^(\\s*)(`{3,})[ \\t]*(?i:(python3|python|py3|py))(?:[ \\t].*)?$",
            "beginCaptures": {
                "2": {
                    "name": "punctuation.definition.fenced.txtcustom"
                },
                "3": {
                    "name": "fenced_code.block.language.txtcustom"
                }
            },
            "end": "^(\\s*)(`{3,})[ \\t]*$",
            "endCaptures": {
                "2": {
                    "name": "punctuation.definition.fenced.txtcustom"
                }
            },
            "name": "markup.fenced_code.block.txtcustom",
            "contentName": "meta.embedded.block.python",
            "patterns": [
                {
                    "include": "source.python"
                }
            ]
        },
